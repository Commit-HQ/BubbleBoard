# Copy to `.env` and set before running or building. Values are read at build time.

# Public origin of this installation: https:// and a hostname, optionally with a port, and nothing after
# it (http:// is accepted for localhost). Canonical URLs and link previews are written into the
# prerendered HTML, so set this where you build: a Worker variable at runtime can't change those pages.
PUBLIC_SITE_URL=https://bubbleboard.example.com

# How much of an event a teacher may prepare, used by the editor and by the server that publishes it.
# The defaults, used when a value isn't set, are 30 photos of at most 10 MB each. Each photo is made
# smaller on the phone and compressed before anything is sent: count on roughly a megabyte of storage for
# each photo of an event, within the R2 limits below, and more for a photo full of children, whose covered
# faces travel separately. More photos also means more for a phone to hold while a teacher works.
# After a change, run `npm run deploy`.
PUBLIC_EVENT_PHOTOS=30
PUBLIC_EVENT_PHOTO_MB=10

# What BubbleBoard may keep in Cloudflare R2, where board photos and notice files are stored, and how many
# uploads and downloads it may make there each month. R2 charges once a month's use passes its free
# allowance of 10 GB stored, a million uploads, and ten million downloads; these defaults, used when a value
# isn't set, stay a tenth below it, so even a misused card can't run up a bill. At a limit, new photos and
# files wait until there's room or the next month, and 0 stops them. After a change, run `npm run deploy`.
STORAGE_LIMIT_GB=9
STORAGE_UPLOADS_PER_MONTH=900000
STORAGE_DOWNLOADS_PER_MONTH=9000000
