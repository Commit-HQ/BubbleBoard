# Headers for prerendered pages and static assets, which Cloudflare serves without running the Worker.
# Keep in sync with src/hooks.server.ts. The rest of the CSP is a <meta> tag generated by SvelteKit,
# and a <meta> CSP can't set frame-ancestors.
/*
  Content-Security-Policy: frame-ancestors 'none'
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
