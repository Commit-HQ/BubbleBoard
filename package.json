{
	"name": "bubbleboard",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "wrangler d1 migrations apply DB --local && vite dev",
		"build": "vite build",
		"preview": "wrangler d1 migrations apply DB --local && wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"setup-link": "node scripts/setup-link.js",
		"setup-link:local": "node scripts/setup-link.js --local",
		"prepare": "svelte-kit sync",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"gen": "wrangler types",
		"test": "vitest run",
		"deploy": "npm run build && wrangler deploy && wrangler d1 migrations apply DB --remote && node scripts/setup-link.js --if-missing",
		"validate": "npm run check && npm run lint && npm run test && npm run build"
	},
	"devDependencies": {
		"@fontsource-variable/hanken-grotesk": "^5.3.0",
		"@fontsource-variable/hedvig-letters-serif": "^5.3.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.13.4",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^5.0.0",
		"wrangler": "^4.97.0"
	},
	"engines": {
		"node": ">=24 <25"
	},
	"dependencies": {
		"@tiptap/core": "^3.31.3",
		"@tiptap/pm": "^3.31.3",
		"@tiptap/starter-kit": "^3.31.3",
		"qr": "^0.7.0"
	}
}
