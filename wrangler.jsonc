{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "bubbleboard",
	"compatibility_date": "2026-09-11",
	"compatibility_flags": ["nodejs_als"],
	// SvelteKit's fetch handler, with the queue and scheduled handlers its adapter doesn't build; run
	// `npm run build` first. The adapter reads wrangler.build.jsonc, whose `assets` must match these.
	"main": "worker/index.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Access records; the schema is in migrations/.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bubbleboard",
			"migrations_dir": "migrations"
		}
	],
	// Board photos and notice files, encrypted in the browser. The bucket stays private: only the Worker reads
	// it, for devices that may see a photo or file, within the limits in .env (src/lib/server/storage.ts).
	"r2_buckets": [{ "binding": "FILES", "bucket_name": "bubbleboard-files" }],
	// Attempts to set up the installation or connect a card, per client address. A parents' meeting on the
	// kindergarten's Wi-Fi is one address for every phone in the room, so the limit leaves room for all of them.
	"ratelimits": [
		{
			"name": "CARD_ATTEMPTS",
			"namespace_id": "1001",
			"simple": { "limit": 100, "period": 60 }
		}
	],
	// Notifications for new notices, in groups the queue handler sends one message at a time, so an
	// invocation stays within the Free plan's outgoing requests (src/lib/server/push.ts).
	"queues": {
		"producers": [{ "binding": "NOTIFICATIONS", "queue": "bubbleboard-notifications" }],
		"consumers": [{ "queue": "bubbleboard-notifications", "max_batch_size": 1, "max_retries": 3 }]
	},
	// The daily cleanup of expired notices and sessions, and of files no record names
	// (src/lib/server/cleanup.ts).
	"triggers": { "crons": ["23 3 * * *"] },
	// No invocation logs (product-spec.md §45).
	"observability": { "enabled": false },
	"workers_dev": true,
	"preview_urls": true
}
